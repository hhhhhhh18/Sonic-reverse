# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored. NEVER commit a real key, and never put it in this file.

# Required for real music search (YouTube Data API v3). Create it in Google Cloud Console
# (see the README), then restrict it to "YouTube Data API v3".
# Server-side only: do NOT rename it with a NEXT_PUBLIC_ prefix.
YOUTUBE_API_KEY=

# --- Optional (defaults shown) ---------------------------------------------------------
# YOUTUBE_REGION_CODE=IN
# MUSIC_CACHE_TTL_SECONDS=21600      # how long identical searches are served from memory
# MUSIC_RATE_LIMIT_PER_MIN=20        # uncached searches allowed per client per minute
# MUSIC_DAILY_SEARCH_BUDGET=90       # uncached searches per Pacific day (YouTube's default quota is small); 0 = no guard

# Use the built-in demo catalog only (also what the bundled e2e tests use):
# MUSIC_PROVIDER=mock

# Troubleshooting only:
# YOUTUBE_KEY_TRANSPORT=query        # send the key as ?key= instead of the x-goog-api-key header
